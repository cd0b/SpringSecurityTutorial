				"exec": [
					"if (pm.request.url.path.includes(\"login\") && pm.response.code === 200) {\r",
					"    const jsonResponse = pm.response.json();\r",
					"    const token = jsonResponse.token\r",
					"\r",
					"    if (token) {\r",
					"        pm.collectionVariables.set(\"bearerToken\", token);\r",
					"    }\r",
					"}"
